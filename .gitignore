# Ignore subdirectories in external_repos
external_repos/*/

# OS junk
.DS_Store

# Python cache
__pycache__/
*.pyc
*.pyo

# Results (generated data, not source-controlled)
results/.DS_Store
results/*

# Experiment junk
experiments/.DS_Store

# Notebooks (local only)
notebooks/misc.ipynb

# Server runtime artifacts (large / generated; live on the umbrella share)
hf_models/
logs/

# local matplotlib venv for building figures
.venv-fig/

# uv project venv (created per-machine by setup_uv_daic.sh / setup_fresh.sh)
.venv/
